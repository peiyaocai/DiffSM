> args <- commandArgs(TRUE)
> 
> n <- as.numeric(args[[1]])
> p <- as.numeric(args[[2]])
> sig <- as.numeric(args[[3]])
> s <- as.numeric(args[[4]])
> m <- as.numeric(args[[5]])
> l1 <- 5
> l2 <- 0.5
> alpha <- 0.5
> rho <- 1
> 
> 
> source('gaussian_helpers.R')
